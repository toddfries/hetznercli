#!/bin/sh
hcli=${HCLI:-$HOME/bin/hcli}

echo "Storage min 40g price max 100"
$hcli -p market -o format=price -o disk.min=40000 -o price.max=100 \
	-o re=ECC -o re=ENT "$@"
echo

echo "Storage min 27g price max 80"
$hcli -p market -o format=price -o disk.min=27000 -o price.max=80 \
	-o re=ECC -o re=ENT "$@"
echo

echo "Disk count min 5 price max 80"
$hcli -p market -o format=price -o disk.count.min=5 -o price.max=80 \
	-o re=ECC -o re=ENT "$@"
echo

echo "Lotta disk cheap"
$hcli -p market -o format=price -o disk.min=80000 \
	-o re=ECC -o re=ENT "$@"
echo

echo "Lucky draw: 7 disk min"
$hcli -p market -o format=price -o disk.count.min=7 \
	-o re=ECC -o re=ENT "$@"
echo
