#!/bin/sh
hcli=${HCLI:-$HOME/bin/hcli}

echo "2disk 8gb storage <=\$50 >=64G ram"
$hcli -p market -M 64 -o format=price \
	-o disk.count.min=2 -o disk.min=8000 -o price.max=50 \
	-o re=ECC -o re=ENT "$@"

echo "2disk 4gb storage <=\$40 >=64G ram"
$hcli -p market -M 64 -o format=price \
	-o disk.count.min=2 -o disk.min=4000 -o price.max=40 \
	-o re=ECC -o re=ENT "$@"

echo "2disk 8gb storage <=\$72 >=128G ram"
$hcli -p market -M 128 -o format=price \
	-o disk.count.min=2 -o disk.min=8000 -o price.max=72 \
	-o re=ECC -o re=ENT "$@"
