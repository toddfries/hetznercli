#!/bin/sh
hcli=${HCLI:-$HOME/bin/hcli}

echo "2disk 8gb storage <=\$50 >=64G ram"
$hcli -p market -o format=price,sort=price,mem.min=64,disk.count.min=2,disk.min=8000,re=ECC,re=ENT,top=5 "$@"
echo

echo "top5 2disk 4gb >=64G ram"
$hcli -p market -o format=price,sort=price,mem.min=64,disk.count.min=2,disk.min=4000,re=ECC,re=ENT,top=5 "$@"
echo

echo "top5 2disk >=128G ram"
$hcli -p market -o format=price,sort=price,mem.min=128,disk.count.min=2,disk.min=8000,top=5,re=ECC,re=ENT "$@"
echo
