STDERR->autoflush(1);
STDOUT->autoflush(1);

our $opt_v = 0;
our $opt_c = $ENV{'HOME'}."/.hcli.conf";
our $opt_p;

our $opt_C; # market_search, cpu bench min
our $opt_D; # market_search, disk size min
our $opt_M; # market_search, mem size min
our $opt_X = "Ent"; # market_search, text search string
our $opt_O; # market_search, sort order
our $opt_f; # traffic from, YYYY-MM or YYYY-MM-DD
our $opt_t; # traffic to, YYYY-MM or YYYY-MM-DD
our $opt_i; # server number, product id, or address
our $opt_n; # ptr name
our $opt_r; # reference server number
our $opt_k; # stored ssh key fingerprint
our $opt_T; # market_order rehearsal (test=true)
our $argc = 0;


getopts('c:p:vC:D:M:O:X:f:t:i:n:r:k:T');

my $conf = $opt_c;

my $r = ReadConf->new(conf => $opt_c);
my $config = $r->readconf()->{_};

if (!defined($config->{huser})) {
	die "Didn't read huser from $opt_c";
}
if (!defined($config->{hpass})) {
	die "Didn't read hpass from $opt_c";
}


my $hetzner = WWW::Hetzner->new(
	huser => $config->{huser},
	hpass => $config->{hpass},
);

if ($opt_p eq "ip") {

	my $parsed = $hetzner->ips();
	print recurse_dump($parsed);
	exit(0);
}

if($opt_p eq "servers") {
	my $parsed = $hetzner->get("server");
	api_exit($parsed, "no servers");
	my $subs = $hetzner->get("subnet");
	my $subfail = Hetznercli::Fail::classify($subs);
	if ($subfail) {
		printf "subnet %s %s %s\n", $subfail->{status}, $subfail->{code}, $subfail->{message};
	}
	my @subrows = Hetznercli::Subnet::rows($subs);
	foreach my $row (@{ $parsed }) {
		my $sv = (ref($row) eq "HASH" && ref($row->{server}) eq "HASH")
			? $row->{server} : $row;
		next if ref($sv) ne "HASH";
		my $num = defined($sv->{server_number}) ? $sv->{server_number} : "";
		my $name = defined($sv->{server_name}) ? $sv->{server_name} : "";
		my $paid = defined($sv->{paid_until}) ? $sv->{paid_until} : "";
		my $addr = Hetznercli::Addr::host_from_server($sv);
		my $gw = Hetznercli::Subnet::gateway_for(\@subrows, $num);
		$addr = "<none>" if !defined($addr) || $addr eq "";
		$gw = "<none>" if !defined($gw) || $gw eq "";
		printf "%s %s paid %s\n", $num, $name, $paid;
		printf "\t%s gw %s\n", $addr, $gw;
		if (defined($sv->{server_ip}) && $sv->{server_ip} =~ /^\d+\.\d+\.\d+\.\d+\z/) {
			printf "\tipv4 %s\n", $sv->{server_ip};
		}
		if ($addr ne "<none>") {
			my $ptr = $hetzner->rdns_get($addr);
			if (ref($ptr) eq "HASH" && $ptr->{missing}) {
				print "\tptr unset\n";
			} elsif (ref($ptr) eq "HASH" && $ptr->{error} && !defined($ptr->{ptr})) {
				printf "\tptr error %s\n", $ptr->{error};
			} elsif (ref($ptr) eq "HASH") {
				printf "\tptr %s\n", (defined($ptr->{ptr}) ? $ptr->{ptr} : "");
			}
		}
	}
	exit(0);
}

if($opt_p eq "reset") {
	my $call = "reset";
	my $parsed = $hetzner->get($call);
	foreach my $r (@{$parsed}) {
		my $types;
		foreach my $t (@{$r->{reset}->{type}}) {
			if (!defined($types)) {
				$types = $t;
				next;
			}
			$types .= ",".$t;
		}
		printf "%7d %16s %s\n",
			$r->{reset}->{server_number},
			$r->{reset}->{server_ip},
			$types;
	}
	#print recurse_dump($parsed);
	exit(0);
}

